# ──────────────────────────────────────────────────────────────────────
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ──────────────────────────────────────────────────────────────────────
# Database Configuration
# ──────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/auth-platform
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme_secure_password

# ──────────────────────────────────────────────────────────────────────
# Redis Configuration
# ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme_redis_password

# ──────────────────────────────────────────────────────────────────────
# JWT Configuration
# ──────────────────────────────────────────────────────────────────────
# Generate strong secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-different-256-bit-refresh-secret-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ──────────────────────────────────────────────────────────────────────
# Security Configuration
# ──────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000  # 15 minutes in milliseconds
RATE_LIMIT_WINDOW=900000 # 15 minutes in milliseconds
COOKIE_SECRET_KEY=your-cookie-secret-key-change-this

# ──────────────────────────────────────────────────────────────────────
# OAuth Configuration (Google)
# ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/oauth/google/callback

# ──────────────────────────────────────────────────────────────────────
# OAuth Configuration (GitHub)
# ──────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/oauth/github/callback

# ──────────────────────────────────────────────────────────────────────
# Email Configuration (Optional - for password reset, etc.)
# ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com

# ──────────────────────────────────────────────────────────────────────
# Monitoring & Logging (Optional)
# ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
ELASTICSEARCH_URL=http://localhost:9200
DATADOG_API_KEY=your-datadog-api-key

# ──────────────────────────────────────────────────────────────────────
# Development Tools (Optional)
# ──────────────────────────────────────────────────────────────────────
ME_USERNAME=admin
ME_PASSWORD=changeme_mongo_express_password
